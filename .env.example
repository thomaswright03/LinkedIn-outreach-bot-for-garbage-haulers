# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Where the logged-in browser profile and SQLite database live
HAULERBOT_DATA_DIR=./data
# Your details, used to sign messages in your own voice
HAULERBOT_SENDER_NAME=Thomas
HAULERBOT_SENDER_COMPANY=
# Optional: a real, verifiable result from the Mountain High Disposal rollout.
# The drafter only cites numbers you put here; leave blank to keep it qualitative.
HAULERBOT_CASE_STUDY_RESULT=
# Daily caps (keep these low; LinkedIn restricts accounts that look automated)
HAULERBOT_MAX_INVITES_PER_DAY=20
HAULERBOT_MAX_MESSAGES_PER_DAY=25
# Seconds to wait between actions (randomized in this range)
HAULERBOT_MIN_DELAY=45
HAULERBOT_MAX_DELAY=180
# Only act between these local hours
HAULERBOT_ACTIVE_HOURS=8-18
# Days to wait before the single follow-up to a non-responder
HAULERBOT_FOLLOWUP_AFTER_DAYS=5
# Replies to inbound messages: "draft" (you approve each one) or "auto"
HAULERBOT_REPLY_MODE=draft
# Claude model used for drafting and reply classification
HAULERBOT_MODEL=claude-opus-5-5
